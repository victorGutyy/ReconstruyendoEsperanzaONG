# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Variables prefixed with NEXT_PUBLIC_ reach the browser: never put a secret in them.
# Reference: docs/04-arquitectura.md §8

# --- Supabase (local: values printed by `npx supabase start` / `npx supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: bypasses RLS. Server only (src/lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=

# --- Rate limiting (docs/05 §7) ---
# Local development and CI: in-memory limiter (single process). NEVER set it on Vercel.
RATE_LIMIT_DRIVER=memory
# Staging/production (Vercel): Upstash. Without these, login and MFA fail closed.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Scheduled jobs (Vercel Cron, docs/04 §5.3) ---
# Secret, 32+ random characters (e.g. `openssl rand -hex 32`). Without it the
# daily public-photo sync refuses to run. Not needed for local development.
# CRON_SECRET=

# --- Added in later phases ---
# Public address of the site (links shared on WhatsApp and Open Graph, step 8.2).
# Optional on Vercel: without it the deployment address is used.
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_MEDIA_BASE_URL=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# --- Contact form (step 8.7, docs/05 §7) ---
# Cloudflare Turnstile. The site key is public by design; the secret is not.
# Local development and CI (RATE_LIMIT_DRIVER=memory) fall back to
# Cloudflare's published test keys; on Vercel the form refuses to work without them.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Secret, 32+ random characters (e.g. `openssl rand -hex 32`): the key of the
# HMAC that stores the sender's IP without keeping it.
# CONTACT_IP_HASH_SECRET=
# RESEND_API_KEY=
