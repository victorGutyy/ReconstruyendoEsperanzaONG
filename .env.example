# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Variables prefixed with NEXT_PUBLIC_ reach the browser: never put a secret in them.
# Reference: docs/04-arquitectura.md §8

# --- Supabase (local: values printed by `npx supabase start` / `npx supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret: bypasses RLS. Server only (src/lib/supabase/admin.ts).
SUPABASE_SECRET_KEY=

